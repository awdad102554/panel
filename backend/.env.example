DATABASE_URL=postgresql+asyncpg://panel:panel@localhost:5432/panel
JWT_SECRET_KEY=change-me-in-production

# 共享 MySQL(与 InfoWeb 同库)——存案件标签 case_tags + IP→用户名绑定 user_ip。
# 默认连 InfoWeb 的 判决书生成 库(root),只需在 .env 提供 MYSQL_PASSWORD。
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_DB=判决书生成
MYSQL_PASSWORD=
# JWT_算法/有效期一般无需改:JWT_ALGORITHM=HS256, JWT_EXPIRE_MINUTES=720

# 前端跨域白名单(JSON 数组或逗号分隔都支持;仅前后端不同源部署时才需要配)
# CORS_ORIGINS=http://localhost:5173

# 内网案件系统(10.96.10.78:8080)——与 InfoWeb 同一套账号/登录流程。
# 生产/内网环境按需覆盖;沙箱或无内网时设 CASE_SYSTEM_ENABLED=false 走本地统计回退。
CASE_SYSTEM_ENABLED=true
CASE_SYSTEM_BASE_URL=http://10.96.10.78:8080
CASE_SYSTEM_USERNAME=huhailiang
CASE_SYSTEM_PASSWORD=<与 InfoWeb modules/config.py 的 LOGIN_PASSWORD 一致的加密串>
# CASE_SYSTEM_TIMEOUT=30          # 内网接口超时(秒)
# CASE_SYSTEM_SESSION_HOURS=10    # 内网会话复用时长

# 内网案件监控(一般无需改,页面"时限设置"里的阈值存库、优先级高于此处)
# CASE_SYNC_INTERVAL_MINUTES=60   # 后台轻量同步间隔(分钟)
# CASE_URGENCY_RESERVE_DAYS=3     # 预约阶段超期点
# CASE_URGENCY_RECEIVE_DAYS=5     # 收件审查时限
# CASE_URGENCY_SOON_DAYS=3        # 审理剩余天数"临近"阈值
# CASE_URGENCY_URGENT_DAYS=1      # 审理剩余天数"紧急"阈值
# CASE_URGENCY_PAUSED_ALERT_DAYS=15  # 中止提醒
# CASE_MEDIATION_ALERT_DAYS=30    # 调解超时提醒
# CASE_STATUTE_PERIOD_DAYS=120    # 默认审限(占位,待业务规则明确)

# 预登记案件分档阈值(页面"时限设置"可改,存库优先)
# VIRTUAL_CASE_SOON_DAYS=30       # 临近阈值(登记后自然日)
# VIRTUAL_CASE_URGENT_DAYS=60     # 紧急阈值

# 天眼查 MCP(https://mcp.tianyancha.com/mcp)——查企业基本信息。
# 鉴权用 API Key:请求头 Authorization: Bearer <key>;key 留空则页面返回"未配置"。
TIANYANCHA_ENABLED=true
TIANYANCHA_BASE_URL=https://mcp.tianyancha.com/mcp
TIANYANCHA_API_KEY=
# TIANYANCHA_TIMEOUT=30           # MCP 接口超时(秒)

